      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "#datos\n",
        "x = np.array([1.0, 1.3, 1.6, 1.9, 2.2])\n",
        "y = np.array([0.7651977, 0.6200860, 0.4554022, 0.2818186, 0.1103623])\n",
        "\n",
        "# Punto donde se desea interpolar\n",
        "xp = 1.5\n",
        "\n",
        "\n",
        "# ==========================\n",
        "# Método de Neville\n",
        "# ==========================\n",
        "n = len(x)\n",
        "\n",
        "Q = np.zeros((n, n))\n",
        "\n",
        "# Primera columna\n",
        "for i in range(n):\n",
        "    Q[i, 0] = y[i]\n",
        "\n",
        "# Construcción de la tabla\n",
        "for i in range(1, n):\n",
        "    for j in range(1, i + 1):\n",
        "        Q[i, j] = (\n",
        "            (xp - x[i - j]) * Q[i, j - 1]\n",
        "            - (xp - x[i]) * Q[i - 1, j - 1]\n",
        "        ) / (x[i] - x[i - j])\n",
        "\n",
        "# Resultado final\n",
        "P = Q[n - 1, n - 1]\n",
        "\n",
        "# ==========================\n",
        "# Mostrar tabla\n",
        "# ==========================\n",
        "\n",
        "tabla = pd.DataFrame(Q)\n",
        "tabla.columns = [f\"Q{i}\" for i in range(n)]\n",
        "\n",
        "print(\"\\nTABLA DE NEVILLE\\n\")\n",
        "print(tabla.round(7))\n",
        "print(\"\\nResultado final:\")\n",
        "print(f\"P({xp}) = {P:.7f}\")\n",
        "\n",
        "\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "coef = np.polyfit(x, y, n - 1)\n",
        "polinomio = np.poly1d(coef)\n",
        "\n",
        "xx = np.linspace(min(x), max(x), 300)\n",
        "yy = polinomio(xx)\n",
        "\n",
        "# ==========================\n",
        "# Gráfica\n",
        "# ==========================\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.plot(xx, yy, 'b-', label='Polinomio interpolante')\n",
        "plt.plot(x, y, 'ro', markersize=8, label='Datos originales')\n",
        "plt.plot(xp, P, 'ks', markersize=9,\n",
        "         label=f'P({xp})={P:.7f}')\n",
        "\n",
        "plt.xlabel('x')\n",
        "plt.ylabel('f(x)')\n",
        "plt.title('Interpolación de Neville')"
